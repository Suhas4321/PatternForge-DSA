# Copy to backend/.env and adjust. Everything is optional.

# Default: local SQLite file backend/patternforge.db
# Supabase (install requirements-postgres.txt first):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Optional AI Socratic coach ----------------------------------------------------------
# Without any key the app uses the built-in hints and model interview scripts.

# Option A: any OpenAI-compatible chat endpoint, e.g. Snowflake Cortex REST API
# AI_BASE_URL=https://<account-identifier>.snowflakecomputing.com/api/v2/cortex/v1
# AI_API_KEY=<programmatic access token>
# AI_MODEL=claude-sonnet-4-5

# Option B: Google Gemini (used when option A is not set)
# GEMINI_API_KEY=<key from aistudio.google.com>
# GEMINI_MODEL=gemini-2.5-flash
