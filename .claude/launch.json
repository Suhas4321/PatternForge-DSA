{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --reload --reload-dir app --reload-dir ../content --reload-include '*.yaml' --reload-include '*.json'"],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --host 127.0.0.1"],
      "port": 5173
    }
  ]
}
